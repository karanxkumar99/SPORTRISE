{
  "name": "sportrise",
  "version": "1.0.0",
  "private": true,
  "description": "SportRise (खेल उत्थान) - India's Grassroots Sports Event & Athlete Ranking Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31"
  },
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:backend && npm run build:frontend",
    "seed": "npm run seed --workspace=backend",
    "seed:events": "npm run seed:events --workspace=backend",
    "clean": "npm run clean --workspace=backend",
    "test:integration": "npm run test:integration --workspace=backend",
    "lint": "npm run lint --workspace=frontend"
  },
  "keywords": [
    "sportrise",
    "sports-tech",
    "india",
    "olympics",
    "athlete-ranking",
    "event-management",
    "grassroots-sports"
  ],
  "author": "SportRise Team",
  "license": "ISC"
}

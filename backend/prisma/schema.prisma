// SportRise (खेल उत्थान) Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  athleteId          String              @unique
  fullName           String
  mobile             String
  email              String              @unique
  password           String
  state              String
  district           String
  sport              String
  ageCategory        String              @default("U-19")
  gender             String              @default("Male")
  isVerified         Boolean             @default(false)
  skillIndex         Int                 @default(500)
  nationalRank       Int?
  stateRank          Int?
  districtRank       Int?
  bio                String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  performanceRecords PerformanceRecord[]
  otps               OTP[]
  applications       Application[]
}

model OTP {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model PerformanceRecord {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport             String
  metrics           String   // JSON string of metric name/value pairs
  skillIndex        Int      // 0 - 1000 calculated score
  aiStrengths       String   // JSON array or markdown text
  aiImprovements    String   // JSON array or markdown text
  aiRecommendations String   // JSON array or markdown text
  recordedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
}

model Institution {
  id                      String         @id @default(uuid())
  name                    String
  type                    String         // School, College, University, Institute
  logo                    String?
  email                   String         @unique
  password                String
  contactNumber           String
  website                 String?
  address                 String
  city                    String
  state                   String
  country                 String         @default("India")
  pincode                 String
  authorizedPersonName    String
  authorizedPersonContact String
  description             String?
  coordinatorName         String
  coordinatorEmail        String
  coordinatorPhone        String
  latitude                Float?
  longitude               Float?
  isVerified              Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  events                  Event[]
  notifications           Notification[]
}

model Event {
  id                     String         @id @default(uuid())
  institutionId          String
  institution            Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name                   String
  category               String         // Sports Tournament, Athletics, Football, Cricket, Basketball, Volleyball, Badminton, Chess, Esports, Debate, Quiz, Cultural Event, Academic Competition, Other
  sportGame              String
  bannerImage            String?
  shortDescription       String
  fullDescription        String         // Markdown or rich text
  organizer              String
  hostingInstitution     String
  contactPerson          String
  contactEmail           String
  contactPhone           String
  regStartDate           DateTime
  regEndDate             DateTime
  startDate              DateTime
  endDate                DateTime
  reportingTime          String?
  startTime              String?
  duration               String?
  venueName              String
  venueAddress           String
  city                   String
  state                  String
  latitude               Float?
  longitude              Float?
  rounds                 String?        // JSON array of rounds/matches
  allowedInstitutionsType String        @default("any") // only_ours, selected, any, external_allowed, invite_only
  selectedInstitutions   String?        // JSON string
  minAge                 Int?
  maxAge                 Int?
  gender                 String         @default("All") // All, Male, Female
  classGrade             String?
  collegeYear            String?
  courseDepartment       String?
  skillRequirement       String?
  participationType      String         @default("Individual") // Individual, Team
  teamMinSize            Int?
  teamMaxSize            Int?
  customEligibility      String?
  gameFormat             String?        // JSON string storing format, match style, prizes, certificates, etc.
  rules                  String?        // JSON string storing categorized rules
  documents              String?        // JSON string array of documents
  isPaid                 Boolean        @default(false)
  registrationFee        Float          @default(0)
  gstPercent             Float          @default(0)
  paymentDeadline        DateTime?
  refundPolicy           String?
  visibility             String         @default("Public") // Public, InstitutionOnly, ExternalAllowed, Private
  status                 String         @default("Published") // Draft, Published, Scheduled, Cancelled
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  applications           Application[]
  bookmarks              Bookmark[]
}

model Application {
  id                  String   @id @default(uuid())
  applicationNumber   String   @unique
  eventId             String
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?    @relation(fields: [userId], references: [id])
  applicantName       String
  dob                 DateTime?
  age                 Int
  gender              String
  institutionName     String
  classOrYear         String
  courseDepartment    String?
  studentIdCardNumber String?
  contactNumber       String
  email               String
  parentName          String?
  parentContact       String?
  emergencyContact    String?
  experience          String?
  achievements        String?
  idProofUrl          String?
  documentsUrl        String?
  isTeam              Boolean  @default(false)
  teamName            String?
  captainName         String?
  teamMembers         String?  // JSON array of player names & roles
  status              String   @default("Submitted") // Submitted, Under Review, Approved, Rejected, Waitlisted, Cancelled
  organizerNotes      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Notification {
  id            String       @id @default(uuid())
  userId        String?
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  message       String
  link          String?
  type          String       @default("info") // info, success, warning, alert
  isRead        Boolean      @default(false)
  createdAt     DateTime     @default(now())
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

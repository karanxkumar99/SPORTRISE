{
  "name": "sportrise-backend",
  "version": "1.0.0",
  "description": "SportRise (खेल उत्थान) Backend API Engine",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx scripts/syncDbProvider.ts && tsx watch src/app.ts",
    "sync:db": "tsx scripts/syncDbProvider.ts",
    "build": "tsx scripts/syncDbProvider.ts --generate && tsc",
    "render:build": "tsx scripts/syncDbProvider.ts --require-postgres && prisma db push --skip-generate && npm run build",
    "render:start": "node dist/app.js",
    "start": "node dist/app.js",
    "prisma:generate": "tsx scripts/syncDbProvider.ts --generate",
    "prisma:push": "tsx scripts/syncDbProvider.ts && prisma db push",
    "prisma:seed": "tsx scripts/syncDbProvider.ts && tsx scripts/seedRealisticSportsData.ts",
    "seed": "tsx scripts/syncDbProvider.ts && tsx scripts/seedRealisticSportsData.ts",
    "seed:events": "tsx scripts/seedDemoEvents.ts",
    "test:integration": "tsx scripts/testIntegration.ts",
    "clean": "tsx scripts/cleanAthletes.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.16",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.8.1",
    "@types/nodemailer": "^6.4.16"
  }
}
